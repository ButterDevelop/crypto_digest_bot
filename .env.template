TELEGRAM_BOT_TOKEN=123456789:AA...bot_token...
OPENAI_API_KEY=sk-...openai_key...

# OPENAI_PROXY=http://127.0.0.1:8080
# OPENAI_PROXY=http://user:pass@proxy.com:3128
OPENAI_PROXY=

# Comma-separated list of channels (without https://t.me/)
CHANNELS=channel1,channel2

# How many hours back we look for messages
MAX_HOURS=8

# Max posts per channel per run
MAX_POSTS_PER_CHANNEL=40

# OpenAI model
OPENAI_MODEL=gpt-5.1

# DeepSeek settings (if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LLM Provider: "openai" or "deepseek"
LLM_PROVIDER=openai

# Default interval (minutes) for autodigest when /start_digest is used
DIGEST_INTERVAL_MINUTES=480

# Start hour (0-23 UTC) for digest schedule alignment
DIGEST_START_HOUR=4

# Subscription settings
SUBSCRIPTION_PRICE_STARS=100
SUBSCRIPTION_PERIOD_DAYS=30
RENEWAL_REMINDER_DAYS=3

# DB path
DB_PATH=bot.db
# INITIAL_ADMIN_ID=123456789

# Allowed languages for translation (comma-separated codes)
ALLOWED_LANGUAGES=en,ru,uk,cs